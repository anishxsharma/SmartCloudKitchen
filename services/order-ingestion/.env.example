PORT=8787

# Service role key — server-side only, never ship this to either app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secrets used to verify each aggregator's webhook signature.
# In reality these come from the aggregator's developer portal when you
# register the webhook endpoint.
ZIPP_WEBHOOK_SECRET=change-me
MUNCHLY_WEBHOOK_SECRET=change-me
