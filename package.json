{
  "name": "smartcloudkitchen",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:customer": "npm run start --workspace=customer",
    "dev:kitchen": "npm run start --workspace=kitchen",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18"
  }
}
