{
  "expo": {
    "name": "SCK Kitchen",
    "slug": "smartcloudkitchen-kitchen",
    "scheme": "sckkitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.smartcloudkitchen.kitchen",
      "adaptiveIcon": {
        "backgroundColor": "#14120F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to add a dish photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d076d3fb-6d9b-4de2-910f-05e9c9ec582c"
      }
    },
    "owner": "anishxsharma"
  }
}
